---
import { getExperience } from '@/data/experience';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const experience = getExperience(lang);
---

<section id="experience" class="container-gutter py-28 sm:py-40" aria-label={t('exp.label')}>
  <div class="grid gap-12 md:grid-cols-12 md:gap-8">
    <div class="md:col-span-3">
      <h2
        class="reveal text-sm uppercase tracking-[0.25em] text-bone-faint"
        data-reveal
      >
        {t('exp.label')}
      </h2>
    </div>

    <ol class="md:col-span-9">
      {
        experience.map((item) => (
          <li
            class="reveal group grid gap-2 border-t border-ink-line py-8 sm:grid-cols-[10rem_1fr] sm:gap-8"
            data-reveal
          >
            <span class="text-sm text-bone-faint">{item.period}</span>
            <div>
              <h3 class="text-2xl text-bone">
                {item.role}
                <span class="text-bone-faint"> · {item.company}</span>
              </h3>
              <p class="mt-2 max-w-[52ch] leading-relaxed text-bone-dim">
                {item.description}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
