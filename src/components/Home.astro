---
import Navbar from '@/components/Navbar.astro';
import Hero from '@/components/Hero.astro';
import About from '@/components/About.astro';
import ProjectsIndex from '@/components/ProjectsIndex.astro';
import Experience from '@/components/Experience.astro';
import Contact from '@/components/Contact.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';
import { getProjects } from '@/data/projects';
import { getLangFromUrl, useTranslations, localizePath } from '@/i18n/utils';

/**
 * The full single-page portfolio. Language is derived from the URL, so the
 * same component renders correctly for both `/` (es) and `/en/`.
 */
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const projects = getProjects(lang);

const workStrings = {
  label: t('work.label'),
  heading: t('work.heading'),
};
const workBase = localizePath('/work', lang);
---

<Navbar />
<main id="main">
  <Hero />
  <About />
  <ProjectsIndex
    projects={projects}
    workBase={workBase}
    strings={workStrings}
  />
  <Experience />
  <Contact />
</main>
<ScrollReveal />
