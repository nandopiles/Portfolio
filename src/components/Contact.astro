---
import { site } from '@/data/site';

const year = new Date().getFullYear();
---

<section
  id="contact"
  class="container-gutter flex min-h-svh flex-col justify-between pt-28 pb-10"
  aria-label="Contact"
>
  <div class="flex flex-1 flex-col justify-center">
    <p
      class="reveal text-sm uppercase tracking-[0.25em] text-bone-faint"
      data-reveal
    >
      (Let's talk)
    </p>

    <h2
      class="reveal mt-8 block text-[length:var(--text-hero)] leading-[0.95] text-bone"
      data-reveal
    >
      Let's build<br />something.
    </h2>

    <div class="reveal mt-12 flex flex-wrap items-center gap-x-10 gap-y-4" data-reveal>
      <a
        href={`mailto:${site.email}`}
        class="link-underline text-lg text-bone"
      >
        {site.email}
      </a>
      <ul class="flex flex-wrap gap-x-8 gap-y-2">
        {
          site.socials
            .filter((s) => s.label !== 'Email')
            .map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link-underline text-lg text-bone-dim"
                >
                  {s.label}
                </a>
              </li>
            ))
        }
      </ul>
    </div>
  </div>

  <footer
    class="flex flex-col items-start justify-between gap-3 border-t border-ink-line pt-8 text-sm text-bone-faint sm:flex-row sm:items-center"
  >
    <span>© {year} {site.name}. All rights reserved.</span>
    <span>Built with Astro, GSAP &amp; care.</span>
    <a href="#hero" class="link-underline text-bone-dim">Back to top ↑</a>
  </footer>
</section>
