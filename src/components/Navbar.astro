---
import { site } from '@/data/site';

const links = [
  { label: 'About', href: '#about' },
  { label: 'Work', href: '#work' },
  { label: 'Contact', href: '#contact' },
];
---

<header class="fixed inset-x-0 top-0 z-50 mix-blend-difference">
  <nav
    class="container-gutter flex items-center justify-between py-5"
    aria-label="Primary"
  >
    <a
      href="#hero"
      class="font-[family-name:var(--font-display)] text-lg font-bold tracking-tight text-bone"
      aria-label={`${site.name} — home`}
    >
      {site.initials}<span class="text-accent">.</span>
    </a>

    <ul class="flex items-center gap-6 sm:gap-9">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="link-underline text-base font-medium tracking-wide text-bone/90 transition-opacity hover:opacity-100 sm:text-lg"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>


