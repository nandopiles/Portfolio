---
import { getLangFromUrl, useTranslations, localizePath, stripLangPrefix } from '@/i18n/utils';
import { languages, type Lang } from '@/i18n/ui';
// Inline the logo so its `currentColor` strokes/fills inherit the brand colour.
import logo from '@/../public/logo.svg?raw';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
  { label: t('nav.about'), href: '#about' },
  { label: t('nav.work'), href: '#work' },
  { label: t('nav.contact'), href: '#contact' },
];

// The canonical (unprefixed) path of the current page, so each language link
// points to the same page in the other language.
const currentPath = stripLangPrefix(Astro.url.pathname);
const langCodes = Object.keys(languages) as Lang[];
---

<header class="fixed inset-x-0 top-0 z-50 mix-blend-difference">
  <nav
    class="container-gutter grid grid-cols-[1fr_auto_1fr] items-center py-2 sm:flex sm:justify-between"
    aria-label="Primary"
  >
    <!-- Logo: centred on mobile (middle grid column), left-aligned from sm up.
         In the flow (not absolute) so the nav padding applies to it. -->
    <a
      href={localizePath('/', lang) + '#hero'}
      class="col-start-2 inline-flex items-center justify-self-center text-bone transition-opacity hover:opacity-80 [&_svg]:h-16 [&_svg]:w-16 sm:col-start-auto sm:justify-self-auto sm:[&_svg]:h-28 sm:[&_svg]:w-28"
      aria-label={t('nav.home')}
      set:html={logo}
    />

    <div class="col-start-3 flex items-center justify-self-end gap-6 sm:col-start-auto sm:justify-self-auto sm:gap-9">
      <!-- Primary nav links: hidden on mobile, shown from sm up. -->
      <ul class="hidden items-center gap-6 sm:flex sm:gap-9">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="link-underline text-base font-medium tracking-wide text-bone/90 transition-opacity hover:opacity-100 sm:text-lg"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Language switcher: active language keeps a fixed underline;
           the inactive one animates its underline in on hover/focus. -->
      <div
        class="flex items-center gap-2 text-base font-medium sm:text-lg"
        aria-label={t('nav.langLabel')}
      >
        {
          langCodes.map((code, i) => (
            <>
              {i > 0 && <span class="text-bone-faint" aria-hidden="true">|</span>}
              <a
                href={localizePath(currentPath, code)}
                hreflang={code}
                lang={code}
                aria-current={code === lang ? 'true' : undefined}
                class:list={[
                  'link-underline transition-colors',
                  code === lang
                    ? 'is-active text-bone'
                    : 'text-bone-faint hover:text-bone',
                ]}
              >
                {languages[code]}
              </a>
            </>
          ))
        }
      </div>
    </div>
  </nav>
</header>
