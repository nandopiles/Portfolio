---
import { site } from '@/data/site';

const links = [
  { label: 'About', href: '#about' },
  { label: 'Work', href: '#work' },
  { label: 'Contact', href: '#contact' },
];
---

<header
  class="fixed inset-x-0 top-0 z-50 mix-blend-difference"
  data-navbar
>
  <nav
    class="container-gutter flex items-center justify-between py-5"
    aria-label="Primary"
  >
    <a
      href="#hero"
      class="font-[family-name:var(--font-display)] text-lg font-bold tracking-tight text-bone"
      aria-label={`${site.name} — home`}
    >
      {site.initials}<span class="text-accent">.</span>
    </a>

    <ul class="flex items-center gap-6 sm:gap-9">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="link-underline text-sm font-medium tracking-wide text-bone/90 transition-opacity hover:opacity-100"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // Hide the navbar when scrolling down, reveal when scrolling up.
  const nav = document.querySelector('[data-navbar]') as HTMLElement | null;
  if (nav) {
    let lastY = window.scrollY;
    let ticking = false;

    const update = () => {
      const y = window.scrollY;
      const goingDown = y > lastY && y > 120;
      nav.style.transform = goingDown ? 'translateY(-100%)' : 'translateY(0)';
      nav.style.transition = 'transform 0.4s var(--ease-out-expo)';
      lastY = y;
      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true }
    );
  }
</script>
