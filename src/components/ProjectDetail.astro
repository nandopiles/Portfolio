---
import type { Project } from '@/data/projects';
import { site } from '@/data/site';
import BrowserFrame from '@/components/BrowserFrame.astro';
import { getLangFromUrl, useTranslations, localizePath } from '@/i18n/utils';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
const backHref = localizePath('/', lang) + '#work';

/** Clean host for the browser-frame address bar (e.g. "example.com"). */
let host = '';
try {
  if (project.demo) host = new URL(project.demo).host;
} catch {
  host = '';
}
---

<main id="main" class="container-gutter pt-32 pb-24">
  <a href={backHref} class="link-underline text-sm text-bone-dim">
    {t('project.back')}
  </a>

  <!-- Full-width poster header. -->
  <header class="mt-12">
    <span class="text-sm uppercase tracking-[0.25em] text-bone-faint">
      {project.index} — {project.year}
    </span>
    <h1 class="poster-title mt-5 text-[length:var(--text-display)] text-bone">
      {project.title}
    </h1>
  </header>

  <!-- Two-column split: text on the left, a compact contained image on the
       right. Both share the row so neither the image nor the text dominates. -->
  <div class="mt-14 grid gap-x-14 gap-y-12 lg:grid-cols-12 lg:items-start">
    <div class="flex flex-col gap-12 lg:col-span-6">
      <p class="text-2xl leading-relaxed text-bone">
        {project.summary}
      </p>

      <div>
        <h2 class="text-sm uppercase tracking-[0.25em] text-bone-faint">
          {t('project.overview')}
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-bone-dim">
          {project.description ?? project.summary}
        </p>
      </div>

      <div class="flex flex-wrap items-start gap-x-14 gap-y-8 border-t border-ink-line pt-8">
        <div>
          <h2 class="text-sm uppercase tracking-[0.25em] text-bone-faint">
            {t('project.stack')}
          </h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {
              project.stack.map((tech) => (
                <li class="rounded-full border border-ink-line px-3 py-1 text-sm text-bone-dim">
                  {tech}
                </li>
              ))
            }
          </ul>
        </div>

        {
          (project.demo || project.repo) && (
            <div>
              <h2 class="text-sm uppercase tracking-[0.25em] text-bone-faint">
                {t('nav.work')}
              </h2>
              <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-lg">
                {project.demo && (
                  <a
                    href={project.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-underline text-bone"
                  >
                    {t('project.demo')}
                  </a>
                )}
                {project.repo && (
                  <a
                    href={project.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-underline text-bone-dim"
                  >
                    {t('project.source')}
                  </a>
                )}
              </div>
            </div>
          )
        }
      </div>
    </div>

    <BrowserFrame
      url={host}
      class="shadow-[10px_12px_0_rgba(0,0,0,0.55)] lg:col-span-6 lg:sticky lg:top-28"
    >
      <img
        src={project.cover ?? project.image}
        alt={project.title}
        loading="eager"
        decoding="async"
        style={`view-transition-name: project-${project.slug}`}
        class="block h-auto w-full"
      />
    </BrowserFrame>
  </div>
</main>

<footer
  class="container-gutter flex flex-col items-start justify-between gap-3 border-t border-ink-line pt-8 pb-10 text-sm text-bone-faint sm:flex-row sm:items-center"
>
  <span>{site.name}</span>
  <span>{t('contact.rights')}</span>
  <span>{year}</span>
</footer>
