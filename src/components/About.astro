---
import { skills } from '@/data/skills';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  id="about"
  class="container-gutter py-32 sm:py-48"
  aria-label={t('nav.about')}
>
  <div class="mx-auto max-w-3xl text-left">
    <h2
      class="reveal text-sm uppercase tracking-[0.25em] text-bone-faint"
      data-reveal
    >
      {t('about.label')}
    </h2>

    <p
      class="reveal mt-8 text-[length:var(--text-section)] leading-[1.08] text-bone"
      data-reveal
    >
      {t('about.lead')}
    </p>
  </div>
</section>

<!-- Skills — a hand-placed "sticker collage". The badges are laid out in a
     centred cluster, each at a slightly different angle like stickers stuck by
     hand. They reveal on scroll (via ScrollReveal) and straighten + lift on
     hover. Static: no auto-scrolling. -->
<section class="container-gutter pb-32 sm:pb-48" aria-label={t('about.stack')}>
  <div class="mx-auto max-w-4xl">
    <h3
      class="reveal text-center text-sm uppercase tracking-[0.25em] text-bone-faint"
      data-reveal
    >
      {t('about.stack')}
    </h3>

    <ul class="mt-10 flex flex-wrap items-center justify-center gap-x-5 gap-y-6" role="list">
      {
        skills.map((skill, i) => {
          // Deterministic per-index "hand-placed" angles (no random → stable
          // between SSR and client).
          const angles = [-5, 3, -2, 6, -4, 2, -6, 4, -3];
          const angle = angles[i % angles.length];
          return (
            <li data-reveal class="reveal">
              <span
                class="sticker px-5 py-2.5 text-lg sm:text-xl"
                style={`transform: rotate(${angle}deg);`}
              >
                {skill}
              </span>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
