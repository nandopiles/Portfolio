---
import { site } from '@/data/site';
---

<section
  id="hero"
  class="relative flex min-h-svh flex-col justify-center container-gutter pb-16 pt-32"
  aria-label="Introduction"
>
  <p
    class="mb-8 flex items-center gap-3 text-sm uppercase tracking-[0.25em] text-bone-dim"
    data-hero-line
  >
    <span class="inline-block h-px w-10 bg-accent"></span>
    {site.role} · {site.location}
  </p>

  <h1 class="max-w-[15ch] text-[length:var(--text-hero)] text-bone">
    <span class="block overflow-hidden">
      <span class="block" data-hero-line>Hi, I'm</span>
    </span>
    <span class="block overflow-hidden">
      <span class="block" data-hero-line>{site.name}.</span>
    </span>
  </h1>

  <p
    class="mt-10 max-w-[42ch] text-lg leading-relaxed text-bone-dim sm:text-xl"
    data-hero-line
  >
    {site.tagline}
  </p>

  <div class="mt-12 flex flex-wrap items-center gap-6" data-hero-line>
    <a
      href="#work"
      data-cursor="Work"
      class="group inline-flex items-center gap-3 rounded-full border border-bone/25 px-7 py-3 text-sm font-medium text-bone transition-colors hover:bg-bone hover:text-ink"
    >
      View my work
      <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
    </a>
    <a
      href="#contact"
      class="link-underline text-sm font-medium text-bone-dim"
    >
      Get in touch
    </a>
  </div>

  <div
    class="pointer-events-none absolute bottom-8 right-[var(--spacing-gutter)] hidden items-center gap-2 text-xs uppercase tracking-[0.2em] text-bone-faint sm:flex"
    aria-hidden="true"
  >
    Scroll
    <span class="inline-block h-8 w-px animate-pulse bg-bone-faint"></span>
  </div>
</section>

<script>
  import { gsap, prefersReducedMotion } from '@/lib/gsap';

  function playHero() {
    const lines = gsap.utils.toArray<HTMLElement>('[data-hero-line]');
    if (!lines.length) return;

    if (prefersReducedMotion()) {
      gsap.set(lines, { opacity: 1, y: 0 });
      return;
    }

    gsap.fromTo(
      lines,
      { yPercent: 110, opacity: 0 },
      {
        yPercent: 0,
        opacity: 1,
        duration: 1.1,
        ease: 'expo.out',
        stagger: 0.09,
        delay: 0.15,
      }
    );
  }

  playHero();
  // Re-run after Astro view transitions swap the DOM.
  document.addEventListener('astro:page-load', playHero);
</script>
