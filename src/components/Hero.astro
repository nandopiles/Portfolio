---
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  id="hero"
  class="relative flex min-h-svh flex-col justify-center container-gutter pb-16 pt-32"
  aria-label={t('nav.home')}
>
  <div class="mx-auto w-full max-w-6xl">
    <!-- Poster-style headline: three short, huge words. What I do — the hook —
         not my name. The name lives in the sticker tucked into the first line. -->
    <!-- The headline flows at its natural width; the name sticker is layered
         ON TOP (absolute) so it reads like a sticker slapped over the type,
         rather than a badge pushing the words aside. -->
    <div class="relative">
      <h1 class="poster-title text-[length:var(--text-hero)]">
        <span class="block">
          <span class="poster-line poster-line-fill">{t('hero.title.1')}</span>
        </span>
        <span class="block">
          <span class="poster-line poster-line-fill">{t('hero.title.2')}</span>
        </span>
        <span class="block">
          <span
            class="poster-line poster-line-fill poster-line-shine"
            data-text={t('hero.title.3')}
          >
            {t('hero.title.3')}
          </span>
        </span>
      </h1>

      <!-- Sticker slapped over the top-left corner of the "F". -->
      <span
        class="sticker hero-sticker absolute left-[-2.75rem] top-[-1.7rem] z-10 px-6 py-2 text-xs sm:left-[-3.75rem] sm:top-[-2.2rem] sm:text-sm"
        style="text-transform: none; font-weight: 700; -webkit-text-fill-color: var(--color-ink); color: var(--color-ink);"
      >
        {t('hero.sticker')}
      </span>
    </div>
  </div>

  <div
    class="pointer-events-none absolute bottom-8 right-gutter hidden items-center gap-2 text-xs uppercase tracking-[0.2em] text-bone-faint sm:flex"
    aria-hidden="true"
  >
    {t('hero.scroll')}
    <span class="inline-block h-8 w-px animate-pulse bg-bone-faint"></span>
  </div>
</section>

