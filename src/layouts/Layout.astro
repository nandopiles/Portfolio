---
import { ClientRouter } from 'astro:transitions';
import BaseHead from '@/components/BaseHead.astro';
import Cursor from '@/components/Cursor.astro';
import SmoothScroll from '@/components/SmoothScroll.tsx';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <BaseHead title={title} description={description} image={image} lang={lang} />
    <ClientRouter />
    <script is:inline>
      // Swap the no-js class as early as possible so CSS can react.
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[10000] focus:rounded focus:bg-bone focus:px-4 focus:py-2 focus:text-ink"
    >
      {t('a11y.skip')}
    </a>

    <slot />

    <!-- Interactive islands -->
    <!--
      Lenis drives the scroll metrics that every ScrollTrigger depends on, so it
      must hydrate deterministically (client:load), not lazily. With client:idle
      it could start after the pinned Work section and scroll reveals had already
      measured their triggers against native scroll, leaving them dead on the
      first (cold) load. The Cursor is a static island: its own vanilla script
      self-initialises on load and on every view transition.
    -->
    <SmoothScroll client:load />
    <Cursor />

    <script>
      // Shift the page background per section: lifted (lighter) from About
      // through Work, then deeper during Experience. Because several sections
      // can share a class, we track which elements are visible per class and
      // only toggle the class off once none of its sections are on screen.
      let bgObserver: IntersectionObserver | null = null;

      function watchSectionBackgrounds() {
        bgObserver?.disconnect();

        const sections: Array<{ id: string; cls: string }> = [
          { id: '#about', cls: 'bg-lifted' },
          { id: '#work', cls: 'bg-lifted' },
          { id: '#experience', cls: 'experience-active' },
        ];

        const classForEl = new Map<Element, string>();
        const visibleByClass = new Map<string, Set<Element>>();

        for (const { id, cls } of sections) {
          const el = document.querySelector(id);
          if (el) {
            classForEl.set(el, cls);
            if (!visibleByClass.has(cls)) visibleByClass.set(cls, new Set());
          } else {
            document.body.classList.remove(cls);
          }
        }
        if (classForEl.size === 0) return;

        bgObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              const cls = classForEl.get(entry.target);
              if (!cls) continue;
              const set = visibleByClass.get(cls)!;
              if (entry.isIntersecting) set.add(entry.target);
              else set.delete(entry.target);
              document.body.classList.toggle(cls, set.size > 0);
            }
          },
          // Consider a section active as soon as any part crosses the middle
          // band of the viewport. Contiguous sections (About → Work) overlap at
          // their shared edge, so the lifted background stays continuous with no
          // gap or flicker between them.
          { threshold: 0, rootMargin: '-40% 0px -40% 0px' }
        );
        for (const el of classForEl.keys()) bgObserver.observe(el);
      }

      watchSectionBackgrounds();
      document.addEventListener('astro:page-load', watchSectionBackgrounds);
    </script>
  </body>
</html>
