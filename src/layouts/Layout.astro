---
import { ClientRouter } from 'astro:transitions';
import BaseHead from '@/components/BaseHead.astro';
import Cursor from '@/components/Cursor.tsx';
import SmoothScroll from '@/components/SmoothScroll.tsx';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <BaseHead title={title} description={description} image={image} />
    <ClientRouter />
    <script is:inline>
      // Swap the no-js class as early as possible so CSS can react.
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[10000] focus:rounded focus:bg-bone focus:px-4 focus:py-2 focus:text-ink"
    >
      Skip to content
    </a>

    <slot />

    <!-- Interactive islands -->
    <SmoothScroll client:idle />
    <Cursor client:idle />

    <script>
      // Shift the page background per section: lighter over Work, darker over
      // Experience. Each section toggles its own body class as it enters view.
      let bgObserver: IntersectionObserver | null = null;

      function watchSectionBackgrounds() {
        bgObserver?.disconnect();

        const sections: Array<{ id: string; cls: string }> = [
          { id: '#work', cls: 'work-active' },
          { id: '#experience', cls: 'experience-active' },
        ];

        const map = new Map<Element, string>();
        for (const { id, cls } of sections) {
          const el = document.querySelector(id);
          if (el) map.set(el, cls);
          else document.body.classList.remove(cls);
        }
        if (map.size === 0) return;

        bgObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              const cls = map.get(entry.target);
              if (cls) document.body.classList.toggle(cls, entry.isIntersecting);
            }
          },
          // Trigger once a section meaningfully fills the viewport.
          { threshold: 0.35 }
        );
        for (const el of map.keys()) bgObserver.observe(el);
      }

      watchSectionBackgrounds();
      document.addEventListener('astro:page-load', watchSectionBackgrounds);
    </script>
  </body>
</html>
